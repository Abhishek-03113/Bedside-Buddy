{
  "name": "@coosy/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CoOSy Electron shell — TV launcher + local remote server",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "electron-vite build",
    "preview": "ELECTRON_RUN_AS_NODE= electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "clean": "rm -rf out dist release",
    "rebuild-native": "electron-builder install-app-deps",
    "ws-smoke": "node ./scripts/ws-smoke.mjs"
  },
  "dependencies": {
    "@coosy/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "https://github.com/castlabs/electron-releases#v42.8.0+wvcus",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
